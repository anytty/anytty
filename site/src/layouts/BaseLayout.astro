---
import { GitBranch, Menu } from 'lucide-react'
import { canonicalUrl, localizedPath, sitePath, type Locale } from '@/lib/site'
import '@/styles/globals.css'

interface Props {
  locale: Locale
  title?: string
  description: string
  pathname: string
  alternates?: boolean
}

const { locale, title, description, pathname, alternates = true } = Astro.props
const pageTitle = title
  ? `${title} | AnyTTY`
  : locale === 'en' ? 'AnyTTY - Open-source remote terminals' : 'AnyTTY - 开源远程终端'
const docsPath = localizedPath(locale, '/docs/quick-start')
const alternate = !alternates
  ? localizedPath(locale === 'en' ? 'zh-CN' : 'en')
  : locale === 'en'
    ? (pathname === '/' ? '/zh-CN/' : `/zh-CN${pathname}`)
    : pathname.replace(/^\/zh-CN/, '') || '/'
const labels = locale === 'en'
  ? { docs: 'Docs', start: 'Quick start', language: '中文', skip: 'Skip to content', nav: 'Primary navigation', footer: 'Open-source remote terminal software.', support: 'Support', security: 'Security' }
  : { docs: '文档', start: '快速开始', language: 'English', skip: '跳到正文', nav: '主导航', footer: '开源远程终端软件。', support: '支持', security: '安全' }
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl(pathname)} />
    {alternates && <link rel="alternate" hreflang="en" href={canonicalUrl(locale === 'en' ? pathname : alternate)} />}
    {alternates && <link rel="alternate" hreflang="zh-CN" href={canonicalUrl(locale === 'zh-CN' ? pathname : alternate)} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={canonicalUrl(locale === 'en' ? pathname : alternate)} />}
    <link rel="icon" href={sitePath('/assets/app-icon.png')} />
    <link rel="manifest" href={sitePath('/manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AnyTTY" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl(pathname)} />
    <meta property="og:image" content={canonicalUrl('/assets/app-icon.png')} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <header class="site-header">
      <div class="site-container flex h-16 items-center justify-between gap-6">
        <a class="brand" href={sitePath(localizedPath(locale))} aria-label="AnyTTY home">
          <img src={sitePath('/assets/app-icon.png')} alt="" width="32" height="32" />
          <span>AnyTTY</span>
        </a>
        <nav class="hidden items-center gap-1 md:flex" aria-label={labels.nav}>
          <a class="ui-button ui-button-ghost ui-button-sm" href={sitePath(docsPath)}>{labels.docs}</a>
          <a class="ui-button ui-button-ghost ui-button-icon" href="https://github.com/anytty/anytty" aria-label="GitHub"><GitBranch size={16} /></a>
          <a class="ui-button ui-button-outline ui-button-sm" href={sitePath(alternate)} lang={locale === 'en' ? 'zh-CN' : 'en'}>{labels.language}</a>
          <a class="ui-button ui-button-sm" href={sitePath(docsPath)}>{labels.start}</a>
        </nav>
        <details class="mobile-nav md:hidden">
          <summary class="ui-button ui-button-outline ui-button-icon" aria-label={labels.nav}><Menu size={16} /></summary>
          <nav aria-label={labels.nav}>
            <a href={sitePath(docsPath)}>{labels.docs}</a>
            <a href="https://github.com/anytty/anytty">GitHub</a>
            <a href={sitePath(alternate)}>{labels.language}</a>
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <footer class="border-t border-border py-10">
      <div class="site-container flex flex-col gap-5 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; {new Date().getFullYear()} AnyTTY. {labels.footer}</p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
          <a href="https://github.com/anytty/anytty/blob/main/LICENSE">Apache-2.0</a>
          <a href="https://github.com/anytty/anytty/security">{labels.security}</a>
          <a href="https://github.com/anytty/anytty/blob/main/SUPPORT.md">{labels.support}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
