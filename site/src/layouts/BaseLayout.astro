---
import { ArrowDownToLine, GitFork, Languages } from 'lucide-react'

import { NavigationSheet } from '@/components/navigation-sheet'
import { buttonVariants } from '@/components/ui/button'
import { canonicalUrl, localizedPath, sitePath, type Locale } from '@/lib/site'
import { cn } from '@/lib/utils'
import '@/styles/globals.css'

interface Props {
  locale: Locale
  title?: string
  description: string
  pathname: string
  alternates?: boolean
}

const { locale, title, description, pathname, alternates = true } = Astro.props
const pageTitle = title
  ? `${title} | AnyTTY`
  : locale === 'en' ? 'AnyTTY - Keep terminals running' : 'AnyTTY - 让终端持续运行'
const docsPath = localizedPath(locale, '/docs/quick-start')
const homePath = localizedPath(locale)
const alternate = !alternates
  ? localizedPath(locale === 'en' ? 'zh-CN' : 'en')
  : locale === 'en'
    ? (pathname === '/' ? '/zh-CN/' : `/zh-CN${pathname}`)
    : pathname.replace(/^\/zh-CN/, '') || '/'
const labels = locale === 'en'
  ? {
      features: 'Features', screens: 'Apps', docs: 'Docs', download: 'Download', language: '中文',
      skip: 'Skip to content', nav: 'Primary navigation', menuTitle: 'Explore AnyTTY',
      menuDescription: 'Open-source terminal sessions across desktop, web, and mobile.',
      footer: 'Open-source terminals that keep running.', support: 'Support', security: 'Security', close: 'Close menu',
    }
  : {
      features: '功能', screens: '多端体验', docs: '文档', download: '下载', language: 'English',
      skip: '跳到正文', nav: '主导航', menuTitle: '浏览 AnyTTY',
      menuDescription: '跨桌面、Web 与手机持续运行的开源终端。',
      footer: '让终端持续运行的开源工具。', support: '支持', security: '安全', close: '关闭菜单',
    }

const releaseUrl = 'https://github.com/anytty/anytty/releases/tag/v0.0.1-beta.0'
const mobileItems = [
  { label: labels.features, href: `${sitePath(homePath)}#features`, kind: 'default' as const },
  { label: labels.screens, href: `${sitePath(homePath)}#screens`, kind: 'default' as const },
  { label: labels.docs, href: sitePath(docsPath), kind: 'default' as const },
  { label: 'GitHub', href: 'https://github.com/anytty/anytty', kind: 'github' as const },
  { label: labels.language, href: sitePath(alternate), kind: 'language' as const },
  { label: labels.download, href: releaseUrl, kind: 'download' as const, emphasis: true },
]
---

<!doctype html>
<html lang={locale} class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f6" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl(pathname)} />
    {alternates && <link rel="alternate" hreflang="en" href={canonicalUrl(locale === 'en' ? pathname : alternate)} />}
    {alternates && <link rel="alternate" hreflang="zh-CN" href={canonicalUrl(locale === 'zh-CN' ? pathname : alternate)} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={canonicalUrl(locale === 'en' ? pathname : alternate)} />}
    <link rel="icon" href={sitePath('/assets/app-icon.png')} />
    <link rel="manifest" href={sitePath('/manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AnyTTY" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl(pathname)} />
    <meta property="og:image" content={canonicalUrl('/assets/product/mac-tui.webp')} />
    <meta property="og:image:width" content="1800" />
    <meta property="og:image:height" content="1125" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-background text-foreground">
    <a
      class="fixed left-4 top-4 z-[100] -translate-y-24 rounded-md bg-foreground px-4 py-3 text-sm text-background shadow-lg transition-transform focus:translate-y-0"
      href="#main"
    >
      {labels.skip}
    </a>
    <header class="sticky top-0 z-50 bg-background/90 shadow-sm backdrop-blur-xl">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
        <a class="flex h-11 items-center gap-2.5 text-sm font-medium no-underline" href={sitePath(homePath)} aria-label="AnyTTY home">
          <img class="size-8 rounded-lg" src={sitePath('/assets/app-icon.png')} alt="" width="32" height="32" />
          <span>AnyTTY</span>
        </a>

        <nav class="hidden items-center gap-1 lg:flex" aria-label={labels.nav}>
          <a class={cn(buttonVariants({ variant: 'ghost' }), 'h-10 px-3 font-normal')} href={`${sitePath(homePath)}#features`}>{labels.features}</a>
          <a class={cn(buttonVariants({ variant: 'ghost' }), 'h-10 px-3 font-normal')} href={`${sitePath(homePath)}#screens`}>{labels.screens}</a>
          <a class={cn(buttonVariants({ variant: 'ghost' }), 'h-10 px-3 font-normal')} href={sitePath(docsPath)}>{labels.docs}</a>
          <a class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'size-10')} href="https://github.com/anytty/anytty" aria-label="GitHub" title="GitHub">
            <GitFork aria-hidden="true" />
          </a>
          <a class={cn(buttonVariants({ variant: 'ghost' }), 'h-10 gap-2 px-3 font-normal')} href={sitePath(alternate)} lang={locale === 'en' ? 'zh-CN' : 'en'}>
            <Languages aria-hidden="true" />{labels.language}
          </a>
          <a class={cn(buttonVariants({ variant: 'default' }), 'ml-1 h-10 px-4 font-normal')} href={releaseUrl}>
            <ArrowDownToLine aria-hidden="true" />{labels.download}
          </a>
        </nav>

        <NavigationSheet
          client:load
          label={labels.nav}
          title={labels.menuTitle}
          description={labels.menuDescription}
          closeLabel={labels.close}
          items={mobileItems}
        />
      </div>
    </header>

    <slot />

    <footer class="bg-muted/60">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 text-sm text-muted-foreground sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
        <div class="flex items-center gap-3">
          <img class="size-7 rounded-md" src={sitePath('/assets/app-icon.png')} alt="" width="28" height="28" loading="lazy" />
          <p>&copy; {new Date().getFullYear()} AnyTTY. {labels.footer}</p>
        </div>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-3" aria-label="Footer">
          <a class="transition-colors hover:text-foreground" href="https://github.com/anytty/anytty/blob/main/LICENSE">Apache-2.0</a>
          <a class="transition-colors hover:text-foreground" href="https://github.com/anytty/anytty/security">{labels.security}</a>
          <a class="transition-colors hover:text-foreground" href="https://github.com/anytty/anytty/blob/main/SUPPORT.md">{labels.support}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
