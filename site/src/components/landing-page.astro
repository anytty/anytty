    quickStart: '快速开始', github: 'GitHub', release: '下载 Beta',
    installLabel: 'macOS / Linux', windowsInstallLabel: 'Windows', installPlatformLabel: '选择安装平台',
    installCommand: 'curl -fsSL https://raw.githubusercontent.com/anytty/anytty/main/install.sh | sh',
