    historyStats: [['实时内存', '有界'], ['历史容量', '看磁盘'], ['重新连接', '完整上下文']],
    historyNote: '断线、误关窗口，或者 Agent 跑了好几个小时，重新连上后还能看到完整现场。',
    mobileEyebrow: 'Android + iOS', mobileTitle: '手机上先看状态，再决定要不要接管。',
    mobileLead: '手机 App 不是把桌面页面硬塞进小屏幕。你可以快速查看哪些终端还在跑，用触控优化的按键操作，也能直接管理远程文件。',
    mobilePoints: [
      ['终端状态一眼看清', '查看运行中的终端和距离上次输出的时间。'],
