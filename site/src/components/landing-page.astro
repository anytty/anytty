    observerPoints: [
      ['想切哪个终端就切哪个', '切换当前窗口观察的终端时，分屏、浮动窗和工作区布局都保持不变。'],
      ['手机慢也不拖累任务', '每个设备按自己的速度读取画面。手机或网络慢一点，不会让终端里的程序停下来等。'],
    ],
    workbenchEyebrow: '一个工作台', workbenchTitle: '本地和远程终端，放在一起管理。',
    workbenchLead: 'Windows、macOS、Linux 都能用。本地终端、SSH 远程终端和直连终端都进同一个列表，操作方式一致。',
    windowsAlt: 'AnyTTY TUI 在 Windows 上管理多个终端',
    workbenchPoints: [
      ['Windows 原生支持', 'CLI、TUI 和后台服务都有 x64 与 ARM64 版本，核心功能不需要 WSL。'],
      ['远程机器像本地一样操作', '工作站、构建机或远程 Agent，都能像本地终端一样直接进入工作流。'],
      ['一眼看到谁卡住了', '按最近输出排序，快速找到长时间没有动静的终端或任务。'],
    ],
    historyEyebrow: '历史记录不丢', historyTitle: '跑很久，也不怕内存越占越多。',
