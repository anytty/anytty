      ['窗口与面板解绑', true, false, false, false],
      ['远程终端拉进本机 · 像本地窗口一样', true, false, false, false],
      ['全鼠标支持', true, false, false, false],
      ['手机 / 平板客户端', true, false, false, false],
      ['移动端远程文件预览', true, false, false, false],
      ['Web 浏览器访问', true, false, false, false],
      ['全平台（桌面 + 移动）', true, false, false, false],
      ['Windows 原生支持（无需 WSL）', true, false, false, true],
      ['内网穿透（P2P / 中继）', true, false, false, false],
    ],
    installEyebrow: 'Beta 0.0.1', installTitle: '直接装在你现在用的机器上。',
    installLead: '目前提供 macOS、Linux、Windows 安装包，以及未签名的 Android Beta APK。iOS 已支持，但公开安装要等 App Store；Google Play 和 App Store 都在推进中。',
    docs: '阅读文档', releases: '查看 GitHub Releases',
