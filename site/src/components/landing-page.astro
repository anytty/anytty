    compareLead: 'Close the window and see what survives. AnyTTY keeps a pool of persistent terminals your phone, tablet, and browser can all take over — tmux, Zellij, and Windows Terminal don\'t.',
    cloudEyebrow: 'AnyTTY Cloud', cloudTitle: 'Reach your machines, even behind NAT.',
    cloudLead: 'AnyTTY Cloud connects your machines through peer-to-peer paths with an encrypted relay fallback — no router config, no public IP required.',
    cloudCta: 'Open Cloud', cloudMeta: 'P2P hole punching · encrypted relay',
    compareProducts: ['AnyTTY', 'tmux', 'Zellij', 'Windows Terminal'],
