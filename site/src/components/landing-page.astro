      ['Files travel with the session', 'Browse, upload, download, and manage files through the same protected connection.'],
    ],
    tabletEyebrow: 'Tablet workflows', tabletTitle: 'A full working surface when a phone isn\'t enough.',
    tabletLead: 'Run split-screen agent workflows or use terminal-native tools directly from the tablet client.',
    tabletCaptions: ['Codex and OpenCode in a vertical split', 'The TTT editor running inside a terminal'],
    tabletAlts: ['Tablet split screen running Codex and OpenCode', 'TTT editor running inside an AnyTTY terminal on a tablet'],
