    openSource: 'Apache-2.0 · 源码、客户端和构建产物都在 GitHub',
  },
} as const

const t = copy[locale]
const docsPath = sitePath(localizedPath(locale, '/docs/quick-start'))
const releaseUrl = 'https://github.com/anytty/anytty/releases/tag/v0.0.1-beta.0'
const viewIcons = [PanelsTopLeft, TerminalSquare, Laptop, Smartphone]
const observerIcons = [Eye, ShieldCheck]
const workbenchIcons = [MonitorSmartphone, Laptop, Clock3]
const mobileIcons = [Clock3, TerminalSquare, FileStack]
const accessIcons = [Cloud, LockKeyhole, Files]
---

<main id="main" class="bg-background text-zinc-50">
  <div class="hero-cinematic -mt-20 pt-20">
    <section class="relative overflow-hidden px-5 pb-20 pt-24 text-center sm:px-8 sm:pt-32" aria-labelledby="product-title" data-hero>
      <div class="mx-auto max-w-4xl">
        <Badge variant="secondary" className="border-0 bg-[var(--chip)] px-3 py-1 font-mono text-[11px] font-normal text-zinc-200 shadow-none">
          {t.eyebrow}
        </Badge>
        <h1 id="product-title" class="mt-5 text-5xl font-medium leading-none tracking-tight sm:text-6xl">AnyTTY</h1>
        <p class="mt-5 text-2xl font-medium leading-snug text-zinc-100 sm:text-3xl">{t.promise}</p>
      </div>
      <div class="hero-set relative mx-auto mt-12 w-full max-w-6xl [perspective:2400px]">
        <div class="hero-scroll-image group origin-bottom overflow-hidden rounded-2xl bg-zinc-900 shadow-2xl ring-1 ring-[var(--line)]" data-hero-image>
          <img class="block aspect-[2862/1870] w-full cursor-zoom-in object-cover" src={sitePath('/assets/product/tui-main.webp')} alt={t.previewAlt} width="2862" height="1870" data-image-preview data-image-preview-center data-preview-label={t.tuiLabel} />
        </div>
        <figure class="hero-device hero-device-phone hidden lg:block" style={{ '--hero-tilt': '-8deg' }}>
          <img class="block w-full cursor-zoom-in rounded-xl bg-zinc-900 object-cover ring-1 ring-[var(--line-strong)]" src={sitePath('/assets/product/mobile-terminals.webp')} alt={t.mobileAlts[0]} width="480" height="1068" loading="lazy" data-image-preview data-preview-label={t.mobileLabel} />
        </figure>
        <figure class="hero-device hero-device-pad hidden lg:block" style={{ '--hero-tilt': '6deg' }}>
          <img class="block w-full cursor-zoom-in rounded-xl bg-zinc-900 object-cover ring-1 ring-[var(--line-strong)]" src={sitePath('/assets/product/pad-agents.webp')} alt={t.tabletAlts[0]} width="900" height="1179" loading="lazy" data-image-preview data-preview-label={t.tabletLabel} />
        </figure>
      </div>
    </section>
  </div>

  <section class="py-20 sm:py-24 lg:py-28" aria-labelledby="pool-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-zinc-900/60 p-6 ring-1 ring-[var(--line)] sm:p-10 lg:p-14">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
          <div>
            <Badge variant="secondary" className="border-0 bg-[var(--chip)] font-mono text-[11px] font-normal text-zinc-200">{t.poolEyebrow}</Badge>
            <h2 id="pool-title" class="mt-5 text-3xl font-medium leading-tight sm:text-4xl">{t.poolTitle}</h2>
            <p class="mt-5 max-w-2xl text-base font-normal leading-7 text-zinc-400">{t.poolLead}</p>
          </div>

          <div class="pool-waters rounded-2xl bg-zinc-950 p-4 ring-1 ring-[var(--line)] sm:p-6">
            <div class="grid gap-3 sm:grid-cols-2">
              {[
                ['build', 'running', 'make build && npm run test'],
                ['api', 'idle', 'go run ./cmd/anytty-cloud-controller'],
                ['agent', 'blocked', 'opencode --model deepseek-v4-flash'],
                ['files', 'running', 'anytty file watch ./logs'],
              ].map(([name, status, command], index) => (
                <div class="float-card rounded-xl bg-zinc-900 p-4 ring-1 ring-[var(--line)]" style={{ '--float-delay': `${index * 0.4}s` }}>
                  <div class="flex items-center justify-between gap-3">
                    <span class="font-mono text-[11px] font-normal text-zinc-300">{name}</span>
                    <span class={cn('flex items-center gap-1.5 font-mono text-[10px] font-normal', status === 'running' ? 'text-emerald-300' : status === 'blocked' ? 'text-amber-300' : 'text-zinc-400')}>
                      <span class={cn('size-1.5 rounded-full', status === 'running' ? 'bg-emerald-400' : status === 'blocked' ? 'bg-amber-400' : 'bg-zinc-500')} />
                      {status}
                    </span>
                  </div>
                  <p class="mt-3 overflow-hidden text-ellipsis whitespace-nowrap font-mono text-[11px] text-zinc-500">{command}</p>
                </div>
              ))}
            </div>
            <div class="pool-surface mt-4 rounded-xl bg-zinc-900 px-4 py-3 font-mono text-[11px] text-zinc-400 ring-1 ring-[var(--line)]">
              <span class="text-emerald-300">anytty terminal list</span> · 4 running · 1 idle · 0 detached
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="scroll-mt-20 py-20 sm:py-24 lg:py-28" aria-labelledby="observer-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-zinc-900/60 p-6 ring-1 ring-[var(--line)] sm:p-10 lg:p-14">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
          <div>
            <Badge variant="secondary" className="border-0 bg-[var(--chip)] font-mono text-[11px] font-normal text-zinc-200">{t.observerEyebrow}</Badge>
            <h2 id="observer-title" class="mt-5 text-3xl font-medium leading-tight sm:text-4xl">{t.observerTitle}</h2>
            <p class="mt-5 max-w-2xl text-base font-normal leading-7 text-zinc-400">{t.observerLead}</p>
            <div class="mt-8 grid gap-4">
              {t.observerPoints.map(([title, body], index) => {
                const Icon = observerIcons[index]
                return (
                  <div class="lift-card flex items-start gap-4 rounded-2xl bg-zinc-950 p-5 ring-1 ring-[var(--line)]">
                    <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-emerald-400/10 text-emerald-300"><Icon className="size-5" aria-hidden="true" /></span>
                    <div>
                      <h3 class="text-sm font-medium">{title}</h3>
                      <p class="mt-1 text-sm font-normal leading-6 text-zinc-400">{body}</p>
                    </div>
                  </div>
                )
              })}
            </div>
          </div>

          <div class="rounded-2xl bg-zinc-950 p-6 ring-1 ring-[var(--line)]">
            <div class="flex items-center justify-between gap-4 font-mono text-[11px] font-normal text-zinc-400">
              <span class="flex items-center gap-2 text-zinc-200"><TerminalSquare className="size-4 animate-pulse text-emerald-400" aria-hidden="true" />{t.runtime}</span>
              <span>{t.runtimeState}</span>
            </div>
            <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
              {t.views.map((view, index) => {
                const Icon = viewIcons[index]
                return (
                  <div class="lift-card flex min-h-24 flex-col items-center justify-center gap-2 rounded-xl bg-zinc-900 px-3 text-center ring-1 ring-[var(--line)]">
                    <Icon className="size-5 text-zinc-200" aria-hidden="true" />
                    <span class="font-mono text-[11px] font-normal text-zinc-400">{view}</span>
                  </div>
                )
              })}
            </div>
            <div class="mt-6 flex items-center gap-2 border-t border-[var(--line)] pt-4 font-mono text-[11px] font-normal text-zinc-400">
              <Radio className="size-3.5 text-sky-400" aria-hidden="true" />{t.snapshots}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24 lg:py-28" aria-labelledby="workbench-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-zinc-900/60 p-6 ring-1 ring-[var(--line)] sm:p-10 lg:p-14">
