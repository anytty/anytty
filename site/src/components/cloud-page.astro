      },
    ],
    billingNote: '所有价格均为美元。付费订阅会按所选月付或年付周期自动续订，直到取消；结账时可能根据所在地加收税费。',
    routeEyebrow: '连接方式', routeTitle: '能直连就走 P2P，需要时使用加密 Relay。',
    routeLead: 'Cloud 帮助已经获得授权的客户端找到并连接 daemon；终端与文件权限仍由你机器上的 daemon 控制。',
    routeClient: 'Web 或手机客户端', routeP2P: '托管 P2P', routeMachine: '你的机器', routeFallback: '加密 Relay 兜底',
    routePoints: [
      ['托管设备发现', '不用公开 IP，也不用修改路由器设置，就能找到已经注册的机器。'],
      ['端到端保护', '终端与文件流量在直连和 Relay 路径上都会经过身份验证与加密。'],
      ['权限留在本机', 'Cloud 只负责建立连接，机器上的 daemon 仍然是权限边界。'],
    ],
    termsEyebrow: '订阅前说明', termsTitle: '计费和取消方式清楚透明。',
    termsItems: [
      ['付款', 'Cloud 付费订阅、付款方式和收据由 Creem 处理。最终金额和适用税费会在购买前展示。'],
      ['续订与取消', '月付和年付套餐会自动续订。你可以随时在账单门户取消，已付款周期结束前仍可继续使用。'],
      ['本地功能免费', 'AnyTTY 是开源软件。Local、SSH 和 Direct 连接不需要订阅 Cloud。'],
    ],
    terms: '服务条款', privacy: '隐私政策', support: '账单支持', docs: '阅读 Cloud 文档',
  },
} as const

const t = copy[locale]
const localized = (path: string) => sitePath(localizedPath(locale, path))
---

<main id="main" class="bg-background text-zinc-50">
  <section
    class="relative -mt-20 flex min-h-[500px] items-end overflow-hidden border-b border-[var(--line)] bg-zinc-950 px-5 pb-14 pt-32 sm:min-h-[540px] sm:px-8 sm:pb-16"
    aria-labelledby="cloud-page-title"
  >
    <div class="relative mx-auto w-full max-w-7xl">
      <Badge variant="secondary" className="border-0 bg-white/10 font-mono text-[11px] font-normal text-zinc-100 backdrop-blur-md">{t.eyebrow}</Badge>
      <h1 id="cloud-page-title" class="mt-5 max-w-3xl text-5xl font-semibold leading-none text-white sm:text-6xl">{t.title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-200 sm:text-xl">{t.lead}</p>
      <p class="mt-4 font-mono text-sm font-medium text-emerald-300">{t.priceLead}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class={cn(buttonVariants({ variant: 'default', size: 'lg' }), 'h-11 gap-2 px-5')} href="#pricing">
          {t.pricingCta}<ArrowRight className="size-4" aria-hidden="true" />
        </a>
        <a class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'h-11 gap-2 border-white/25 bg-black/25 px-5 text-white backdrop-blur-md hover:bg-white/10')} href="https://cloud.anytty.com/register">
          <Cloud className="size-4" aria-hidden="true" />{t.register}
        </a>
        <a class="inline-flex min-h-11 items-center gap-2 px-2 text-sm font-medium text-zinc-200 underline-offset-4 hover:text-white hover:underline" href="https://cloud.anytty.com/login">
          <LogIn className="size-4" aria-hidden="true" />{t.signIn}
        </a>
      </div>
      <div class="mt-9 flex max-w-3xl flex-wrap items-center gap-x-3 gap-y-2 border-t border-white/10 pt-5 font-mono text-[11px] text-zinc-400" aria-label={`${t.routeClient}, ${t.routeP2P}, ${t.routeMachine}`}>
        <span class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-sky-400"></span>{t.routeClient}</span>
        <ArrowRight className="size-3.5 text-zinc-600" aria-hidden="true" />
        <span class="flex items-center gap-2 text-emerald-300"><span class="size-1.5 rounded-full bg-emerald-400"></span>{t.routeP2P}</span>
        <ArrowRight className="size-3.5 text-zinc-600" aria-hidden="true" />
        <span class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-sky-400"></span>{t.routeMachine}</span>
        <span class="sm:ml-auto">{t.routeFallback}</span>
      </div>
    </div>
  </section>

  <section id="pricing" class="scroll-mt-24 border-b border-[var(--line)] py-16 sm:py-20 lg:py-24" aria-labelledby="pricing-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <Badge variant="secondary" className="border-0 bg-[var(--chip)] font-mono text-[11px] font-normal text-zinc-200">{t.pricingEyebrow}</Badge>
        <h2 id="pricing-title" class="mt-5 text-3xl font-medium leading-tight sm:text-4xl">{t.pricingTitle}</h2>
        <p class="mt-4 text-base leading-7 text-zinc-400">{t.pricingLead}</p>
      </div>

      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {t.plans.map((plan) => (
          <article class={cn('flex min-w-0 flex-col rounded-lg border bg-zinc-900/55 p-6', plan.featured ? 'border-emerald-400/60 shadow-[0_0_0_1px_rgba(52,211,153,.15)]' : 'border-[var(--line)]')}>
            <header class="min-h-32">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-xl font-semibold">{plan.name}</h3>
                {plan.featured && <span class="rounded-full border border-emerald-400/40 bg-emerald-400/10 px-2.5 py-1 font-mono text-[10px] text-emerald-300">{t.popular}</span>}
              </div>
              <p class="mt-3 text-sm leading-6 text-zinc-400">{plan.description}</p>
            </header>

            <div class="mt-5 border-y border-[var(--line)] py-5">
              <div class="flex items-end gap-2">
                <strong class="text-4xl font-semibold text-zinc-50">{plan.price}</strong>
                {plan.price !== '$0' && <span class="pb-1 text-sm text-zinc-400">{t.monthly}</span>}
              </div>
              <p class="mt-2 min-h-5 font-mono text-xs text-zinc-500">
                {plan.annual ? `${t.annualPrefix} ${plan.annual} ${t.annualSuffix}` : t.noPayment}
              </p>
            </div>

            <ul class="mt-6 grid gap-3 text-sm text-zinc-300">
              {plan.features.map((feature) => <li class="flex items-start gap-2.5"><Check className="mt-0.5 size-4 shrink-0 text-emerald-400" aria-hidden="true" />{feature}</li>)}
            </ul>
            <a class={cn(buttonVariants({ variant: plan.featured ? 'default' : 'outline', size: 'lg' }), 'mt-7 h-11 w-full gap-2')} href="https://cloud.anytty.com/register">
              {plan.cta}<ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </article>
        ))}
      </div>
      <p class="mt-6 max-w-4xl text-sm leading-6 text-zinc-500">{t.billingNote}</p>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24" aria-labelledby="route-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-16">
        <div>
          <Badge variant="secondary" className="border-0 bg-[var(--chip)] font-mono text-[11px] font-normal text-zinc-200">{t.routeEyebrow}</Badge>
          <h2 id="route-title" class="mt-5 text-3xl font-medium leading-tight sm:text-4xl">{t.routeTitle}</h2>
          <p class="mt-4 text-base leading-7 text-zinc-400">{t.routeLead}</p>
        </div>

        <div class="overflow-hidden rounded-lg border border-[var(--line)] bg-zinc-950/70">
          <div class="grid items-center gap-3 p-5 sm:grid-cols-[1fr_auto_1fr_auto_1fr] sm:p-7">
            <div class="flex min-h-20 items-center gap-3 rounded-md bg-zinc-900 px-4 ring-1 ring-[var(--line)]"><Network className="size-5 text-sky-400" aria-hidden="true" /><span class="text-sm font-medium">{t.routeClient}</span></div>
            <ArrowRight className="mx-auto size-4 rotate-90 text-zinc-500 sm:rotate-0" aria-hidden="true" />
            <div class="flex min-h-20 items-center gap-3 rounded-md bg-zinc-900 px-4 ring-1 ring-emerald-400/30"><RadioTower className="size-5 text-emerald-400" aria-hidden="true" /><span class="text-sm font-medium">{t.routeP2P}</span></div>
            <ArrowRight className="mx-auto size-4 rotate-90 text-zinc-500 sm:rotate-0" aria-hidden="true" />
            <div class="flex min-h-20 items-center gap-3 rounded-md bg-zinc-900 px-4 ring-1 ring-[var(--line)]"><ShieldCheck className="size-5 text-sky-400" aria-hidden="true" /><span class="text-sm font-medium">{t.routeMachine}</span></div>
          </div>
          <div class="flex items-center justify-center gap-2 border-t border-[var(--line)] bg-amber-400/[0.06] px-5 py-4 font-mono text-xs text-amber-200"><LockKeyhole className="size-4" aria-hidden="true" />{t.routeFallback}</div>
        </div>
      </div>

      <div class="mt-12 grid divide-y divide-[var(--line)] border-y border-[var(--line)] md:grid-cols-3 md:divide-x md:divide-y-0">
        {t.routePoints.map(([title, body]) => (
          <div class="px-0 py-6 md:px-7 first:md:pl-0 last:md:pr-0">
            <h3 class="text-base font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-400">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[var(--line)] bg-zinc-950/35 py-16 sm:py-20" aria-labelledby="billing-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Badge variant="secondary" className="border-0 bg-[var(--chip)] font-mono text-[11px] font-normal text-zinc-200">{t.termsEyebrow}</Badge>
      <h2 id="billing-title" class="mt-5 text-3xl font-medium leading-tight sm:text-4xl">{t.termsTitle}</h2>
      <div class="mt-9 grid gap-8 md:grid-cols-3">
        {t.termsItems.map(([title, body]) => <div><h3 class="text-base font-semibold">{title}</h3><p class="mt-2 text-sm leading-6 text-zinc-400">{body}</p></div>)}
      </div>
      <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 border-t border-[var(--line)] pt-6 text-sm">
        <a class="inline-flex min-h-11 items-center gap-2 text-zinc-300 hover:text-zinc-50" href={localized('/terms')}><ShieldCheck className="size-4" aria-hidden="true" />{t.terms}</a>
        <a class="inline-flex min-h-11 items-center gap-2 text-zinc-300 hover:text-zinc-50" href={localized('/privacy')}><LockKeyhole className="size-4" aria-hidden="true" />{t.privacy}</a>
        <a class="inline-flex min-h-11 items-center gap-2 text-zinc-300 hover:text-zinc-50" href={localized('/support')}><Cloud className="size-4" aria-hidden="true" />{t.support}</a>
        <a class="inline-flex min-h-11 items-center gap-2 text-zinc-300 hover:text-zinc-50" href={localized('/docs/cloud')}><BookOpen className="size-4" aria-hidden="true" />{t.docs}</a>
      </div>
    </div>
  </section>
</main>
