---
import {
  ArrowRight,
  BookOpen,
  Check,
  Cloud,
  LockKeyhole,
  LogIn,
  Network,
  RadioTower,
  ShieldCheck,
} from 'lucide-react'

import { Badge } from '@/components/ui/badge'
import { buttonVariants } from '@/components/ui/button'
import { localizedPath, sitePath, type Locale } from '@/lib/site'
import { cn } from '@/lib/utils'

interface Props { locale: Locale }
const { locale } = Astro.props

const copy = {
  en: {
    eyebrow: 'Optional managed connection service',
    title: 'AnyTTY Cloud',
    lead: 'Reach your AnyTTY machines through managed P2P negotiation, with encrypted Relay when a direct path is unavailable.',
    priceLead: 'Plans from $0. Paid plans start at $9.90 USD per month.',
    pricingCta: 'View pricing', register: 'Create account', signIn: 'Sign in', popular: 'Most popular',
    pricingEyebrow: 'Public pricing', pricingTitle: 'Choose the capacity you need.',
    pricingLead: 'Local, SSH, and Direct connections remain free. Cloud plans add managed machines, P2P negotiation, and Relay capacity.',
    monthly: 'per month', annualPrefix: 'or', annualSuffix: 'per year', noPayment: 'No payment required',
    plans: [
      {
        name: 'Cloud Free', description: 'Managed P2P plus Relay capacity for occasional restricted networks.',
        price: '$0', annual: '', cta: 'Start free', featured: false,
        features: ['2 registered machines', 'Unlimited managed P2P negotiation', '1 concurrent Relay stream', '200 MB Relay per 30-day period'],
      },
      {
        name: 'Personal Pro', description: 'A complete Cloud connection plan for ongoing personal remote work.',
        price: '$9.90', annual: '$118.80', cta: 'Choose Personal Pro', featured: true,
        features: ['10 registered machines', 'Unlimited managed P2P negotiation', '3 concurrent Relay streams', '20 GB Relay per 30-day period'],
      },
      {
        name: 'Power User', description: 'More devices and Relay capacity for frequent, multi-machine work.',
        price: '$19.90', annual: '$238.80', cta: 'Choose Power User', featured: false,
        features: ['30 registered machines', 'Unlimited managed P2P negotiation', '8 concurrent Relay streams', '100 GB Relay per 30-day period'],
      },
    ],
    billingNote: 'All prices are in USD. Paid subscriptions renew automatically at the selected monthly or annual interval until canceled. Taxes may be added at checkout.',
    routeEyebrow: 'How it connects', routeTitle: 'Direct when possible. Encrypted Relay when needed.',
    routeLead: 'Cloud helps an authorized client find and reach your daemon. Your daemon still controls terminal and file permissions.',
    routeClient: 'Web or mobile client', routeP2P: 'Managed P2P', routeMachine: 'Your machine', routeFallback: 'Encrypted Relay fallback',
    routePoints: [
      ['Managed discovery', 'Find enrolled machines without exposing a public IP or changing router settings.'],
      ['End-to-end protection', 'Terminal and file traffic is authenticated and encrypted across direct and Relay paths.'],
      ['Local authority', 'Cloud provides reachability; the daemon on your machine remains the permission boundary.'],
    ],
    termsEyebrow: 'Before you subscribe', termsTitle: 'Straightforward billing and cancellation.',
    termsItems: [
      ['Payment', 'Creem processes paid Cloud subscriptions, payment methods, and receipts. Final charges and any applicable tax are shown before purchase.'],
      ['Renewal and cancellation', 'Monthly and annual plans renew automatically. Cancel through the billing portal at any time; access continues through the current paid period.'],
      ['Free local product', 'AnyTTY is open source. Local, SSH, and Direct connections do not require a Cloud subscription.'],
    ],
    terms: 'Terms of Service', privacy: 'Privacy Policy', support: 'Billing support', docs: 'Read Cloud documentation',
  },
  'zh-CN': {
    eyebrow: '可选的托管连接服务',
    title: 'AnyTTY Cloud',
    lead: '通过托管 P2P 协商连接你的 AnyTTY 机器；无法直连时，自动使用加密 Relay 兜底。',
    priceLead: '套餐从 $0 起，付费套餐为每月 $9.90 美元起。',
    pricingCta: '查看价格', register: '创建账号', signIn: '登录', popular: '最受欢迎',
    pricingEyebrow: '公开价格', pricingTitle: '按需要选择连接容量。',
    pricingLead: 'Local、SSH 和 Direct 始终免费。Cloud 套餐增加托管机器、P2P 协商和 Relay 容量。',
    monthly: '每月', annualPrefix: '或', annualSuffix: '每年', noPayment: '无需付款',
    plans: [
      {
        name: 'Cloud Free', description: '提供托管 P2P，以及应对偶发受限网络的 Relay 容量。',
        price: '$0', annual: '', cta: '免费开始', featured: false,
        features: ['2 台已注册机器', '托管 P2P 协商不限并发', '1 路 Relay 并发', '每 30 天 200 MB Relay 流量'],
      },
      {
        name: 'Personal Pro', description: '适合长期个人远程工作的完整 Cloud 连接套餐。',
        price: '$9.90', annual: '$118.80', cta: '选择 Personal Pro', featured: true,
        features: ['10 台已注册机器', '托管 P2P 协商不限并发', '3 路 Relay 并发', '每 30 天 20 GB Relay 流量'],
      },
      {
        name: 'Power User', description: '为多机器和高频 Relay 使用提供更高容量。',
        price: '$19.90', annual: '$238.80', cta: '选择 Power User', featured: false,
