---
import { ArrowUpRight, BookOpen, FileText, Mail, ShieldCheck } from 'lucide-react'

import BaseLayout from '@/layouts/BaseLayout.astro'
import { localizedPath, sitePath, type Locale } from '@/lib/site'

type PageKind = 'privacy' | 'terms' | 'support'

interface LinkItem {
  label: string
  href: string
  external?: boolean
}

interface Section {
  id: string
  title: string
  paragraphs: string[]
  bullets?: string[]
  links?: LinkItem[]
}

interface PageCopy {
  title: string
  description: string
  eyebrow: string
  updated: string
  contactTitle: string
  contactBody: string
  email: string
  sections: Section[]
}

interface Props {
  locale: Locale
  kind: PageKind
}

const { locale, kind } = Astro.props
const isEnglish = locale === 'en'
const localized = (path: string) => sitePath(localizedPath(locale, path))

const copies: Record<Locale, Record<PageKind, PageCopy>> = {
  en: {
    privacy: {
      title: 'Privacy Policy',
      description: 'How AnyTTY handles information across its website, apps, open-source software, and optional managed services.',
      eyebrow: 'AnyTTY / Legal',
      updated: 'Last updated: August 24, 2026',
      contactTitle: 'Privacy questions',
      contactBody: 'Contact us to ask about this policy or exercise an applicable privacy right.',
      email: 'privacy@anytty.com',
      sections: [
        {
          id: 'scope',
          title: '1. Scope',
          paragraphs: [
            'This policy applies to the AnyTTY website, official apps, open-source software, and optional managed services. It does not govern third-party services or independently operated deployments.',
            'AnyTTY can run locally or through connections you control. Information that remains on your own devices is not collected by AnyTTY.',
          ],
        },
        {
          id: 'information',
          title: '2. Information we process',
          paragraphs: ['The information involved depends on which AnyTTY features you use. It may include:'],
          bullets: [
            'Website and diagnostics data, such as IP address, browser or device type, requested pages, timestamps, crash information, and similar technical logs.',
            'Cloud account and service data, such as email address, account identifiers, authentication records, settings, subscription status, and transaction references.',
            'Device and connection metadata, such as device identifiers and labels, authorization records, connection timestamps, route diagnostics, and network information needed to establish or troubleshoot a connection.',
            'Support communications, including the messages, attachments, and contact details you choose to send us.',
            'Limited purchase status supplied by Apple, Google, or another payment provider. AnyTTY does not receive complete payment-card numbers from those providers.',
          ],
        },
        {
          id: 'device-data',
          title: '3. Terminal, file, and device data',
          paragraphs: [
            'Local, SSH, and Direct connections do not route terminal or file content through the AnyTTY managed service. A managed Relay forwards encrypted traffic and does not receive terminal or file permissions.',
            'The mobile apps may request local-network access for device discovery, camera access for QR pairing, photo access when you choose an image, and clipboard access when you invoke copy or paste. These capabilities are used only to perform the action you request.',
          ],
        },
        {
          id: 'use',
          title: '4. How we use information',
          paragraphs: [
            'We use information to provide and secure the services, authenticate accounts and devices, establish requested connections, process subscriptions, maintain reliability, respond to support and abuse reports, communicate material changes, comply with law, and enforce our agreements.',
          ],
        },
        {
          id: 'sharing',
          title: '5. Sharing and service providers',
          paragraphs: [
            'We may share information with vendors that provide infrastructure, authentication, analytics, communications, customer support, fraud prevention, and payment processing; with professional advisers; when required by law; or in connection with a corporate transaction.',
            'We do not sell personal information or share it for cross-context behavioral advertising.',
          ],
        },
        {
          id: 'retention',
          title: '6. Retention and international processing',
          paragraphs: [
            'We keep information only as long as reasonably necessary to provide and secure the services, maintain required records, resolve disputes, and meet legal obligations. Retention depends on the information and its purpose.',
            'AnyTTY and its providers may process information outside your country or region. Where required, we use recognized safeguards for international transfers.',
          ],
        },
        {
          id: 'rights',
          title: '7. Your choices and rights',
          paragraphs: [
            'Depending on where you live, you may have rights to access, correct, delete, restrict, or object to processing, obtain a portable copy, or appeal a request decision. We may need to verify your identity before completing a request.',
            'You can revoke a paired device from AnyTTY access controls and can remove the app or its local data using your operating system.',
          ],
        },
        {
          id: 'security-children',
          title: '8. Security and children',
          paragraphs: [
            'We use administrative, technical, and organizational safeguards designed to protect information, but no transmission or storage method is completely secure.',
            'The services are not directed to children under 13, or a higher minimum age where local law requires one. We do not knowingly collect personal information from children below the applicable age.',
          ],
        },
        {
          id: 'changes',
          title: '9. Changes and contact',
          paragraphs: [
            'We may update this policy as the services or legal requirements change. We will publish the revised policy here and update the date above.',
          ],
        },
      ],
    },
    terms: {
      title: 'Terms of Service',
      description: 'Terms governing AnyTTY websites, software, accounts, and optional managed Cloud services.',
      eyebrow: 'AnyTTY / Legal',
      updated: 'Effective: August 24, 2026',
      contactTitle: 'Questions about these terms',
      contactBody: 'Contact support for service, billing, cancellation, or terms questions.',
      email: 'support@anytty.com',
      sections: [
        {
          id: 'services',
          title: '1. The services',
          paragraphs: [
            'These terms govern access to AnyTTY websites, official apps, accounts, and optional managed services. Open-source components remain governed by their published licenses.',
