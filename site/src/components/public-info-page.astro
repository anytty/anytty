const copy = copies[locale][kind]
const pathname = localizedPath(locale, `/${kind}`)
const Icon = kind === 'privacy' ? ShieldCheck : kind === 'terms' ? FileText : BookOpen
const resolveLink = (href: string) => href.startsWith('/') ? localized(href) : href
---

<BaseLayout locale={locale} title={copy.title} description={copy.description} pathname={pathname}>
  <main id="main" class="pb-20 sm:pb-24">
    <header class="border-b border-[var(--line)] bg-muted/20">
      <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20 lg:px-12">
        <div class="flex items-center gap-3 text-primary">
          <Icon className="size-5" aria-hidden="true" />
          <p class="font-mono text-xs font-semibold uppercase">{copy.eyebrow}</p>
        </div>
        <h1 class="mt-5 max-w-4xl text-4xl font-semibold text-foreground sm:text-5xl">{copy.title}</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-muted-foreground">{copy.description}</p>
        <p class="mt-5 text-sm text-muted-foreground">{copy.updated}</p>
      </div>
    </header>

    <div class="mx-auto grid max-w-7xl gap-12 px-5 py-12 sm:px-8 lg:grid-cols-[13rem_minmax(0,1fr)_17rem] lg:gap-12 lg:px-12 lg:py-16 xl:gap-16">
      <nav class="hidden lg:block" aria-label={isEnglish ? 'On this page' : '本页目录'}>
        <div class="sticky top-28 border-l border-[var(--line)] pl-4">
          <p class="mb-4 text-xs font-semibold uppercase text-muted-foreground">{isEnglish ? 'On this page' : '本页目录'}</p>
          <ol class="space-y-3 text-sm leading-5">
            {copy.sections.map((section) => (
              <li><a class="text-muted-foreground transition-colors hover:text-foreground" href={`#${section.id}`}>{section.title}</a></li>
            ))}
          </ol>
        </div>
      </nav>

      <article class="min-w-0 divide-y divide-[var(--line-soft)]">
        {copy.sections.map((section) => (
          <section id={section.id} class="scroll-mt-28 py-9 first:pt-0">
            <h2 class="text-xl font-semibold text-foreground sm:text-2xl">{section.title}</h2>
            <div class="mt-4 space-y-4 text-base leading-7 text-muted-foreground">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && (
                <ul class="list-disc space-y-3 pl-5 marker:text-primary">
                  {section.bullets.map((bullet) => <li class="pl-1">{bullet}</li>)}
                </ul>
              )}
              {section.links && (
                <div class="flex flex-wrap gap-x-6 gap-y-2 pt-1">
                  {section.links.map((link) => (
                    <a
                      class="inline-flex min-h-11 items-center gap-1.5 font-medium text-primary underline-offset-4 hover:underline"
                      href={resolveLink(link.href)}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noreferrer' : undefined}
                    >
                      {link.label}{link.external && <ArrowUpRight className="size-4" aria-hidden="true" />}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </section>
        ))}
      </article>

      <aside>
        <div class="border-l-2 border-primary pl-5 lg:sticky lg:top-28">
          <p class="text-sm font-semibold text-foreground">{copy.contactTitle}</p>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">{copy.contactBody}</p>
          <a class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-primary underline-offset-4 hover:underline" href={`mailto:${copy.email}`}>
            <Mail className="size-4 shrink-0" aria-hidden="true" />{copy.email}
          </a>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

