---
import LandingPage from '@/components/landing-page.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const description = 'Keep terminal sessions running on machines you own and take control from the TUI, CLI, WebView, Android, or iOS.'
const structuredData = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'AnyTTY', applicationCategory: 'DeveloperApplication', operatingSystem: 'Linux, macOS, Windows, Android, iOS', isAccessibleForFree: true, license: 'https://www.apache.org/licenses/LICENSE-2.0', codeRepository: 'https://github.com/anytty/anytty', downloadUrl: 'https://github.com/anytty/anytty/releases/tag/v0.0.1-beta.0' }
---

<BaseLayout locale="en" description={description} pathname="/">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <LandingPage locale="en" />
</BaseLayout>
