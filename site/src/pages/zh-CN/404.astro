---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { sitePath } from '@/lib/site'
import { buttonVariants } from '@/components/ui/button'
---

<BaseLayout locale="zh-CN" title="页面不存在" description="请求的 AnyTTY 页面不存在。" pathname="/zh-CN/404/" alternates={false}>
  <main id="main" class="mx-auto flex min-h-[calc(100vh-8rem)] max-w-3xl flex-col items-center justify-center px-4 py-20 text-center">
    <p class="font-mono text-sm font-normal text-primary">404</p>
    <h1 class="mt-4 text-3xl font-medium sm:text-4xl">页面不存在</h1>
    <p class="mt-4 text-base font-normal text-muted-foreground">页面可能已经移动，或者当前地址已不可用。</p>
    <a class={`${buttonVariants({ variant: 'default' })} mt-8 h-11 px-5 font-normal`} href={sitePath('/zh-CN/')}>返回 AnyTTY</a>
  </main>
</BaseLayout>
