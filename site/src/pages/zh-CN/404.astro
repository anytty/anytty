---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { sitePath } from '@/lib/site'
---

<BaseLayout locale="zh-CN" title="页面不存在" description="请求的 AnyTTY 页面不存在。" pathname="/zh-CN/404/" alternates={false}>
  <main id="main" class="site-container empty-state">
    <p>404</p>
    <h1>页面不存在</h1>
    <a class="ui-button" href={sitePath('/zh-CN/')}>返回 AnyTTY</a>
  </main>
</BaseLayout>
