---
import LandingPage from '@/components/landing-page.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const description = '一个终端池，所有客户端都能接管。'
const structuredData = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'AnyTTY', applicationCategory: 'DeveloperApplication', operatingSystem: 'Linux, macOS, Windows, Android, iOS', isAccessibleForFree: true, license: 'https://www.apache.org/licenses/LICENSE-2.0', codeRepository: 'https://github.com/anytty/anytty', downloadUrl: 'https://github.com/anytty/anytty/releases/tag/v0.0.1-beta.2' }
---

<BaseLayout locale="zh-CN" description={description} pathname="/zh-CN/">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <LandingPage locale="zh-CN" />
</BaseLayout>
