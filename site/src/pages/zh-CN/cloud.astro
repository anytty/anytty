---
import CloudPage from '@/components/cloud-page.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const description = 'AnyTTY Cloud 的公开价格与产品说明：托管 P2P 连接和加密 Relay 兜底。'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'AnyTTY Cloud',
  description,
  brand: { '@type': 'Brand', name: 'AnyTTY' },
  offers: [
    { '@type': 'Offer', name: 'Cloud Free', price: '0', priceCurrency: 'USD', url: 'https://anytty.com/zh-CN/cloud/#pricing' },
    { '@type': 'Offer', name: 'Personal Pro 月付', price: '9.90', priceCurrency: 'USD', url: 'https://anytty.com/zh-CN/cloud/#pricing' },
    { '@type': 'Offer', name: 'Power User 月付', price: '19.90', priceCurrency: 'USD', url: 'https://anytty.com/zh-CN/cloud/#pricing' },
  ],
}
---

<BaseLayout locale="zh-CN" title="Cloud 价格" description={description} pathname="/zh-CN/cloud/">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <CloudPage locale="zh-CN" />
</BaseLayout>
