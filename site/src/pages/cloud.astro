---
import CloudPage from '@/components/cloud-page.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const description = 'AnyTTY Cloud pricing and product details for managed P2P connections and encrypted Relay fallback.'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'AnyTTY Cloud',
  description,
  brand: { '@type': 'Brand', name: 'AnyTTY' },
  offers: [
    { '@type': 'Offer', name: 'Cloud Free', price: '0', priceCurrency: 'USD', url: 'https://anytty.com/cloud/#pricing' },
    { '@type': 'Offer', name: 'Personal Pro monthly', price: '9.90', priceCurrency: 'USD', url: 'https://anytty.com/cloud/#pricing' },
    { '@type': 'Offer', name: 'Power User monthly', price: '19.90', priceCurrency: 'USD', url: 'https://anytty.com/cloud/#pricing' },
  ],
}
---

<BaseLayout locale="en" title="Cloud pricing" description={description} pathname="/cloud/">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <CloudPage locale="en" />
</BaseLayout>
